# Add project-wide settings below.
#
# Adds a bazel registry with my registry first.
#
# These are `common` and not `build` so that `bazel mod`, `bazel query` and
# `bazel fetch` consult the same registries the build does. With `build` they
# do not, and `bazel mod tidy` then resolves against the BCR alone.
common \
  --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main \
  --registry=https://bcr.bazel.build

# Add your local user settings to file `user.bazelrc`
try-import %workspace%/user.bazelrc
