load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Checks that a consumer can depend on the published module and build its
# public targets. This is what the Bazel Central Registry presubmit runs.
build_test(
    name = "smoke_test",
    targets = [
        "@bazel-go-basic//:hello",
        "@bazel-go-basic//proto:hello",
        "@bazel-go-basic//test:test",
    ],
)
